rules_version = '2';
// Saucy Culture stores all application data (products, orders, tracking, VIPs, leads, audit logs)
// in PostgreSQL via Drizzle ORM + Express (/api/*). Firebase is used exclusively for Google Sign-In Auth.
// Cloud Firestore client access is intentionally locked to default-deny across all paths.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
